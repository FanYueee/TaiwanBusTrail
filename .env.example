# 交通部 TDX 平台憑證（https://tdx.transportdata.tw/ 註冊後取得）
#
# 注意：App 執行期「不會」呼叫 TDX，公車資料一律由 Server 端讀取
#       data/tdx/*.json（由 npm run prefetch:tdx 產生）。
#       這裡的憑證只在執行以下指令時使用：
#         - npm run prefetch:tdx   預先下載公車資料
#         - npm run verify:tdx     Phase 1 資料驗證
#
# 複製此檔為 .env.local 後填入，.env.local 不會進入版控。
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# 選用：若已有現成 access token，可直接填入（優先度高於 Client ID / Secret）
# TDX_ACCESS_TOKEN=

# 選用：瀏覽器 IndexedDB 公車資料快取的保存期限（天），預設 7
TDX_CACHE_TTL_DAYS=7
